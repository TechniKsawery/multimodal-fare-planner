# Skopiuj do .env (plik .env jest w .gitignore; nigdy go nie commituj).
# Opcjonalny token Travelpayouts do cen lotów; bez niego warianty z lotem się nie pojawią.
TRAVELPAYOUTS_TOKEN=

# Obraz MOTIS jest przypięty w docker-compose*.yml do digestu pobranego 2026-11-12:
#   ghcr.io/motis-project/motis@sha256:594eff881d4319549387563a28dffb2ac48650df5422325a44a6c2f69f79e9b9
# Aby użyć innej wersji, odkomentuj i podaj własną wartość. Aktualizacja przypiętego digestu:
#   docker pull ghcr.io/motis-project/motis:latest
#   docker image inspect ghcr.io/motis-project/motis:latest --format "{{index .RepoDigests 0}}"
# i podmień digest w docker-compose*.yml (grep MOTIS_IMAGE) oraz w README.
# MOTIS_IMAGE=ghcr.io/motis-project/motis@sha256:...
